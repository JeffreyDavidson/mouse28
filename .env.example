APP_NAME=Mouse28
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
MOUSE28_PRODUCTION_URL=https://mouse28.com
MOUSE28_PRODUCTION_SSH_HOST=cold-moon
MOUSE28_PRODUCTION_SITE_PATH=/home/forge/mouse28.com/current
# Production: set APP_ENV=production, APP_DEBUG=false, and APP_URL=https://mouse28.com.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# Production: set SESSION_SECURE_COOKIE=true.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=
RESEND_AUDIENCE_ID=

SEED_ADMIN_NAME="Mouse28 Administrator"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

GUIDES_ENABLED=false
GUIDE_REVIEW_INTERVAL_DAYS=180

PODCAST_RSS_URL=https://feeds.transistor.fm/mouse28

TURNSTILE_CONTACT_ACTION=contact-form
TURNSTILE_NEWSLETTER_ACTION=newsletter
TURNSTILE_ALLOWED_HOSTNAMES=localhost,mouse28.test
# Production: include mouse28.com in TURNSTILE_ALLOWED_HOSTNAMES.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
