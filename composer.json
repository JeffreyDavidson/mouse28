{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mouse28/mouse28",
    "type": "project",
    "description": "A Disney parks blog and podcast focused on accessibility and family experiences.",
    "keywords": ["mouse28", "disney", "accessibility", "podcast"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.7",
        "filament/spatie-laravel-tags-plugin": "^5.0",
        "laravel/framework": "^13.23",
        "laravel/head": "^0.2.1",
        "laravel/nightwatch": "^1.30",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4",
        "resend/resend-laravel": "^1.4",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-tags": "^4.11"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "christophrumpel/missing-livewire-assertions": "^4.0",
        "driftingly/rector-laravel": "^2.5",
        "jasonmccreary/double": "^0.7.0",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.4",
        "laravel/doctor": "^0.1.0",
        "laravel/pail": "^1.2.2",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.30.5",
        "laraveldaily/filacheck": "^1.2.4",
        "laraveldaily/filacheck-pro": "^1.1",
        "mrpunyapal/laravel-auditor": "^0.1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-faker": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "pestphp/pest-plugin-mutate": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "rector/rector": "^2.6",
        "spatie/pest-plugin-snapshots": "^2.2",
        "spatie/pest-plugin-test-time": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm ci",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --exclude-testsuite=Browser"
        ],
        "test:browser": "@php artisan test --testsuite=Browser",
        "lint": "vendor/bin/pint --blade",
        "test:lint": "vendor/bin/pint --blade --test",
        "check": [
            "@composer validate --strict --no-check-publish",
            "@composer audit --locked --format=plain",
            "npm audit --audit-level=high",
            "node --test tests/Browser/navigation-timings.test.mjs tests/Browser/benchmark-failures.test.mjs",
            "@test:lint",
            "@test:filacheck",
            "@analyse",
            "@analyse:pest",
            "@test:rector",
            "@test:rector:pest",
            "@test",
            "@test:type-coverage",
            "npm run build",
            "@php artisan test --compact --testsuite=Browser --group=browser-smoke",
            "git diff --check"
        ],
        "test:filacheck": "FILACHECK_DISABLE_AGENT_MODE=1 vendor/bin/filacheck",
        "filacheck:fix": "FILACHECK_DISABLE_AGENT_MODE=1 vendor/bin/filacheck --fix --dirty",
        "test:type-coverage": "php -d memory_limit=2G vendor/bin/pest --type-coverage --min=100 --compact",
        "analyse": "php -d memory_limit=2G vendor/bin/phpstan analyse --no-progress",
        "analyse:pest": "APP_ENV=testing php -d memory_limit=2G vendor/bin/phpstan analyse --configuration=phpstan-pest.neon --no-progress",
        "rector": "vendor/bin/rector process",
        "test:rector": "vendor/bin/rector process --dry-run",
        "rector:pest": "vendor/bin/rector process --config=rector-pest.php",
        "test:rector:pest": "vendor/bin/rector process --config=rector-pest.php --dry-run",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": {
        "filacheck": {
            "type": "composer",
            "url": "https://satis.filamentexamples.com",
            "only": ["laraveldaily/filacheck-pro"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
